# Required: Arturo host root, no path
ARTURO_API_BASE_URL=https://turo.disprz.ai

# Ingress path prefix (Django serves /api; deployments expose /ui/api)
ARTURO_API_PREFIX=/ui/api

# Optional: header each caller uses to supply their own session cookie
ARTURO_SESSION_HEADER=X-Arturo-Session

# Optional fallback cookie for single-user / stdio use.
# Leave UNSET for a hosted deployment so the server stays stateless.
# ARTURO_SESSION=

ARTURO_TIMEOUT_SECONDS=60

# Where humans open a pathway. Only set these if the web app is not served from
# ARTURO_API_BASE_URL, or the workspace route moves.
# ARTURO_WEB_URL=
# ARTURO_PATHWAY_PATH=/ui/workspace/documentToLearning/

# Reel 3.0 defaults (mirror Arturo-Web)
REEL3_BRAND_PRIMARY=#E82028
REEL3_BRAND_SECONDARY=#26C6FF
REEL3_BRAND_ON_PRIMARY=#FFFFFF
REEL3_ART_STYLE=soft-gouache
REEL3_MODEL_ID=eleven_v3
REEL3_CULTURE_CONTEXT=ind
